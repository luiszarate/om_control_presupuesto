<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_imago_budget_category_tree" model="ir.ui.view">
        <field name="name">imago.budget.category.tree</field>
        <field name="model">imago.budget.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_imago_budget_category_form" model="ir.ui.view">
        <field name="name">imago.budget.category.form</field>
        <field name="model">imago.budget.category</field>
        <field name="arch" type="xml">
            <form string="Categoria de presupuesto">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="sequence"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <field name="child_ids" attrs="{'invisible': [('parent_id', '!=', False)]}"
                           context="{'default_company_id': company_id}">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="company_id" invisible="1"/>
                            <field name="active"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_imago_budget_category" model="ir.actions.act_window">
        <field name="name">Categorias</field>
        <field name="res_model">imago.budget.category</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('parent_id', '=', False)]</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_imago_budget_report_form" model="ir.ui.view">
        <field name="name">imago.budget.report.wizard.form</field>
        <field name="model">imago.budget.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Resumen mensual" create="0" delete="0" duplicate="0">
                <header>
                    <button name="action_calculate" type="object" string="Actualizar" class="oe_highlight"
                            help="Vuelve a leer las ordenes de compra con los filtros actuales."/>
                    <button name="action_view_purchase_lines" type="object" string="Detalle de compras"/>
                    <button name="action_view_issues" type="object" string="Incidencias"
                            attrs="{'invisible': [('active_issue_count', '=', 0), ('dismissed_issue_count', '=', 0)]}"/>
                    <button name="action_export_xlsx" type="object" string="Exportar Excel" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="budget_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="cutoff_month"/>
                            <field name="category_id" options="{'no_create': True, 'no_open': True}"
                                   placeholder="Todas"/>
                            <field name="include_subcategories"/>
                        </group>
                        <group>
                            <field name="calculated_at"/>
                            <field name="complete"/>
                            <field name="active_issue_count" invisible="1"/>
                            <field name="has_total_budget" invisible="1"/>
                            <field name="has_total_projection" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         attrs="{'invisible': [('warning_text', '=', False)]}">
                        <field name="warning_text" nolabel="1"/>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         attrs="{'invisible': [('active_issue_count', '=', 0)]}">
                        <strong>Reporte incompleto.</strong>
                        Restante y proyeccion quedan pendientes hasta resolver o descartar estas incidencias:
                        <field name="issue_text" nolabel="1"/>
                        <button name="action_view_issues" type="object" class="btn-link p-0"
                                icon="fa-list" string="Ver detalle y descartar"/>
                    </div>
                    <div class="alert alert-info" role="status"
                         attrs="{'invisible': ['|', ('active_issue_count', '!=', 0), ('dismissed_issue_count', '=', 0)]}">
                        <field name="dismissed_issue_count" nolabel="1" class="oe_inline"/> incidencia(s) descartada(s) no bloquean el reporte.
                        <button name="action_view_issues" type="object" class="btn-link p-0"
                                string="Revisar"/>
                    </div>
                    <group string="Totales" col="6">
                        <field name="authorized_amount"/>
                        <field name="spent_amount"/>
                        <field name="available_amount" attrs="{'invisible': [('complete', '=', False)]}"/>
                        <field name="remaining_pct" widget="percentage"
                               attrs="{'invisible': [('has_total_budget', '=', False)]}"/>
                        <field name="projection_amount"
                               attrs="{'invisible': [('has_total_projection', '=', False)]}"/>
                        <field name="projection_pct" widget="percentage"
                               attrs="{'invisible': ['|', ('has_total_projection', '=', False), ('has_total_budget', '=', False)]}"/>
                    </group>
                    <field name="issue_line_ids" invisible="1"/>
                    <field name="purchase_line_ids" invisible="1"/>
                    <field name="export_file" filename="export_filename" invisible="1"/>
                    <field name="export_filename" invisible="1"/>
                    <field name="line_ids" nolabel="1">
                        <tree create="0" delete="0"
                              decoration-danger="status == 'over'"
                              decoration-warning="status in ('risk', 'unbudgeted', 'incomplete')"
                              decoration-success="status == 'within'">
                            <field name="name"/>
                            <field name="authorized_amount" sum="Total"/>
                            <field name="spent_amount" sum="Total"/>
                            <field name="available_amount" sum="Total"
                                   attrs="{'invisible': [('complete', '=', False)]}"/>
                            <field name="remaining_pct" widget="percentage"
                                   attrs="{'invisible': [('has_budget', '=', False)]}"/>
                            <field name="projection_amount" sum="Total"
                                   attrs="{'invisible': [('has_projection', '=', False)]}"/>
                            <field name="projection_pct" widget="percentage"
                                   attrs="{'invisible': ['|', ('has_projection', '=', False), ('has_budget', '=', False)]}"/>
                            <field name="status"/>
                            <field name="complete" invisible="1"/>
                            <field name="has_budget" invisible="1"/>
                            <field name="has_projection" invisible="1"/>
                            <field name="month_01" sum="Ene"/>
                            <field name="month_02" sum="Feb"/>
                            <field name="month_03" sum="Mar"/>
                            <field name="month_04" sum="Abr"/>
                            <field name="month_05" sum="May"/>
                            <field name="month_06" sum="Jun"/>
                            <field name="month_07" sum="Jul"/>
                            <field name="month_08" sum="Ago"/>
                            <field name="month_09" sum="Sep"/>
                            <field name="month_10" sum="Oct"/>
                            <field name="month_11" sum="Nov"/>
                            <field name="month_12" sum="Dic"/>
                            <field name="currency_id" invisible="1"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_imago_budget_report_issue_tree" model="ir.ui.view">
        <field name="name">imago.budget.report.issue.tree</field>
        <field name="model">imago.budget.report.issue</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0" decoration-muted="dismissed">
                <field name="issue_type"/>
                <field name="name"/>
                <field name="hint"/>
                <field name="dismissed"/>
                <button name="action_dismiss" type="object" string="Descartar" icon="fa-eye-slash"
                        groups="om_control_presupuesto.group_imago_budget_manager"
                        attrs="{'invisible': [('dismissed', '=', True)]}"
                        confirm="La incidencia dejara de marcar el reporte como incompleto. Continuar?"/>
                <button name="action_restore" type="object" string="Restaurar" icon="fa-undo"
                        groups="om_control_presupuesto.group_imago_budget_manager"
                        attrs="{'invisible': [('dismissed', '=', False)]}"/>
            </tree>
        </field>
    </record>

    <record id="view_imago_budget_report_issue_form" model="ir.ui.view">
        <field name="name">imago.budget.report.issue.form</field>
        <field name="model">imago.budget.report.issue</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <h2><field name="name"/></h2>
                    <group>
                        <field name="issue_type"/>
                        <field name="budget_id"/>
                        <field name="dismissed"/>
                        <field name="hint"/>
                    </group>
                    <label for="details"/>
                    <field name="details" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_imago_budget_report_issue_search" model="ir.ui.view">
        <field name="name">imago.budget.report.issue.search</field>
        <field name="model">imago.budget.report.issue</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="details"/>
                <filter name="active" string="Pendientes" domain="[('dismissed', '=', False)]"/>
                <filter name="dismissed" string="Descartadas" domain="[('dismissed', '=', True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_type" string="Tipo" context="{'group_by': 'issue_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_imago_budget_report_purchase_line_tree" model="ir.ui.view">
        <field name="name">imago.budget.report.purchase.line.tree</field>
        <field name="model">imago.budget.report.purchase.line</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0"
                  decoration-warning="inclusion_status in ('unclassified', 'missing_rate')"
                  decoration-muted="inclusion_status == 'excluded_secihti'">
                <button name="action_open_purchase_order" type="object" icon="fa-external-link" string="Abrir OC"/>
                <field name="order_id"/>
                <field name="confirmation_date"/>
                <field name="month"/>
                <field name="partner_id"/>
                <field name="description"/>
                <field name="project_id"/>
                <field name="category_id"/>
                <field name="subcategory_id"/>
                <field name="original_currency_id"/>
                <field name="subtotal_amount" sum="Subtotal"/>
                <field name="tax_amount" sum="Impuestos"/>
                <field name="original_amount" sum="Total original"/>
                <field name="rate" attrs="{'invisible': [('has_conversion', '=', False)]}"/>
                <field name="converted_amount" sum="Total MXN"
                       attrs="{'invisible': [('has_conversion', '=', False)]}"/>
                <field name="currency_id" invisible="1"/>
                <field name="has_conversion" invisible="1"/>
                <field name="inclusion_status"/>
            </tree>
        </field>
    </record>

    <record id="view_imago_budget_report_purchase_line_search" model="ir.ui.view">
        <field name="name">imago.budget.report.purchase.line.search</field>
        <field name="model">imago.budget.report.purchase.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="category_id"/>
                <field name="original_currency_id"/>
                <filter name="included" string="Incluidas" domain="[('inclusion_status', '=', 'included')]"/>
                <filter name="unclassified" string="Sin clasificar" domain="[('inclusion_status', '=', 'unclassified')]"/>
                <filter name="missing_rate" string="Pendientes de conversion" domain="[('inclusion_status', '=', 'missing_rate')]"/>
                <filter name="excluded" string="Excluidas SECIHTI" domain="[('inclusion_status', '=', 'excluded_secihti')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_category" string="Categoria"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="group_by_project" string="Proyecto"
                            context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_month" string="Mes"
                            context="{'group_by': 'month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_imago_budget_report_purchase_line_form" model="ir.ui.view">
        <field name="name">imago.budget.report.purchase.line.form</field>
        <field name="model">imago.budget.report.purchase.line</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_purchase_order" type="object" string="Abrir orden de compra" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="confirmation_date"/>
                            <field name="partner_id"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="project_id"/>
                            <field name="category_id"/>
                            <field name="subcategory_id"/>
                            <field name="inclusion_status"/>
                        </group>
                    </group>
                    <group string="Importes">
                        <field name="original_currency_id"/>
                        <field name="subtotal_amount"/>
                        <field name="tax_amount"/>
                        <field name="original_amount"/>
                        <field name="rate" attrs="{'invisible': [('has_conversion', '=', False)]}"/>
                        <field name="converted_amount" attrs="{'invisible': [('has_conversion', '=', False)]}"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="has_conversion" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_imago_budget_report_summary" model="ir.actions.server">
        <field name="name">Resumen mensual</field>
        <field name="model_id" ref="model_imago_budget_report_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_summary()</field>
    </record>
</odoo>
